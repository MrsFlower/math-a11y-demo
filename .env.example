# ========= 数学公式无障碍学习助手 环境变量示例 =========
# 复制本文件为 .env 并填写，切勿把真实 Key 提交到代码仓库。

# ---- 大模型（OpenAI 兼容接口）----
# 默认走阿里云百炼（DashScope）兼容模式，主用 Qwen。
# 没有 Key 时系统自动降级为本地规则解释（结构树/朗读文本仍然可用）。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 支持逗号分隔的备用链：百炼免费额度按模型 Code 独立（各 100 万 token），
# 某模型额度用尽返回 403（AllocationQuota.FreeTierOnly）时自动切换下一个。
# 建议保持百炼控制台的「免费额度用完即停」开关为开启状态，全程零成本。
# 答辩/录视频当天可临时改为：qwen3.7-max
LLM_MODEL=qwen3.7-plus,qwen-plus-latest,qwen3.5-plus,qwen-flash

# ---- 阶段B：公式图片 OCR ----
# 可选值：qwen-vl（默认，调用百炼视觉模型，无需本地重依赖）
#         pix2text（本地模型，需另行 pip install pix2text）
#         none（关闭 OCR，接口返回“未启用”提示）
OCR_BACKEND=qwen-vl
# 视觉模型同样支持逗号分隔备用链；另有 qwen-vl-ocr-latest / qwen3.5-ocr 专用 OCR 模型可实测对比
OCR_VL_MODEL=qwen3-vl-plus,qwen-vl-max,qwen3-vl-flash

# ---- 语音合成（「听 AI 讲解」按钮，百炼 Qwen-TTS）----
# 同样支持逗号分隔备用链；无 Key 时按钮报错降级，不影响其他功能。
TTS_MODEL=qwen3-tts-flash,qwen-tts
# 音色（百炼系统音色：Cherry / Serena / Ethan / Chelsie 等）
TTS_VOICE=Cherry
# TTS 走百炼原生端点（非 compatible-mode），默认从 LLM_BASE_URL 的域名推导，
# 专属业务空间接入点自动兼容，一般无需手动设置。
# TTS_API_URL=

# ---- 解析引擎默认路线 ----
# 可选值：python（纯 Python：latex2mathml + 自研结构树）
#         sre（Node.js Speech Rule Engine，需 npm install 后可用）
# 前端每次请求也可以显式指定 engine 参数覆盖此默认值。
PARSE_ENGINE=python
