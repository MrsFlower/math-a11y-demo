{
  "manifest_version": 3,
  "name": "数学公式无障碍学习助手",
  "version": "0.7.5",
  "description": "选中或提取当前页面的公式，转译成读屏友好的纯文本，或获得中文讲解，可追问、可回看。默认连接云端服务，开箱即用；也可在侧边栏「服务设置」改为本机服务。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["sidePanel", "contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8321/*", "https://*.fcapp.run/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "打开公式助手（侧边栏）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "capture-selection": {
      "suggested_key": { "default": "Ctrl+Shift+M" },
      "description": "按已保存的默认模式处理公式或打开输入"
    }
  }
}
