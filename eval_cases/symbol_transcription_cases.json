[
  {
    "id": "sqrt_basic",
    "category": "根号",
    "text": "已知函数 f(x)=sqrt(3x+1)，求其定义域。",
    "expected": [
      "√(3x+1)"
    ]
  },
  {
    "id": "nth_root",
    "category": "多次根号",
    "text": "化简 \\sqrt[3]{x} 与 \\sqrt[n]{a+b}。",
    "expected": [
      "3次√(x)",
      "n次√(a+b)"
    ]
  },
  {
    "id": "superscript_simple",
    "category": "上标",
    "text": "展开 (x+1)^2，注意 x^3 与 x^n 的项。",
